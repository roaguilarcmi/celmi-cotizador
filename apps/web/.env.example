# Copia este archivo como .env.local (no se versiona) y llena los valores desde el panel de Supabase:
# Project Settings → API Keys.

# Públicos: viajan al navegador por diseño (la seguridad la dan las reglas RLS de la base).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETO: sólo lo usa el servidor para tareas de administración (dar de alta usuarios, restablecer 2FA).
# Nunca lo compartas ni lo pegues en un chat.
SUPABASE_SECRET_KEY=
