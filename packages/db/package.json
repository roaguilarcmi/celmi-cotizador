{
  "name": "@celmi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Esquema de PostgreSQL (Supabase): migraciones SQL versionadas, permisos por fila y auditoría.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrar": "node --env-file=.env.local scripts/migrar.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "primer-admin": "node --env-file=.env.local scripts/primer-administrador.ts",
    "verificar": "node --env-file=.env.local scripts/verificar.ts",
    "respaldo": "node --env-file=.env.local scripts/respaldo.ts",
    "respaldo:verificar": "node --env-file=.env.local scripts/verificar-respaldo.ts"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "vitest": "5.0.3"
  }
}
